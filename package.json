{
  "name": "civaccount",
  "version": "3.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/fetch-private-data.mjs && node scripts/build-dataset-version.mjs && node scripts/generate-coverage-stats.mjs",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "node scripts/validate/validate.mjs",
    "validate:verbose": "node scripts/validate/validate.mjs --verbose",
    "validate:links": "node scripts/validate/validate.mjs --link-check",
    "proof": "node scripts/validate/proof.mjs",
    "proof:selftest": "node scripts/validate/proof-selftest.mjs",
    "proof:lock": "node scripts/validate/lock-council.mjs",
    "proof:verify-lock": "node scripts/validate/verify-council-lock.mjs",
    "proof:bradford": "node scripts/validate/bradford-absolute.mjs",
    "proof:ratchet": "node scripts/validate/proof-ratchet.mjs",
    "reverify": "node scripts/validate/reverify.mjs",
    "reverify:write": "node scripts/validate/reverify.mjs --write",
    "checksum:update": "node scripts/validate/update-checksums.mjs",
    "sync:band-d": "python3 scripts/parse-area-band-d.py && node scripts/sync-band-d.mjs",
    "generate:coverage": "node scripts/generate-coverage-stats.mjs",
    "generate:proven": "node scripts/generate-proven-fields.mjs",
    "generate:provenance": "node scripts/generate-provenance.mjs",
    "generate:image-manifest": "node scripts/generate-image-manifest.mjs",
    "generate:dataset-version": "node scripts/build-dataset-version.mjs",
    "wayback:backfill": "node scripts/wayback-backfill.mjs",
    "wayback:save": "node scripts/wayback-backfill.mjs --save",
    "pipeline:selftest": "node scripts/council-research/pipeline-selftest.mjs",
    "pipeline:status": "node scripts/council-research/pipeline-status.mjs",
    "audit:data": "node scripts/data-audit-log.mjs",
    "indexnow:ping": "node scripts/indexnow-ping.mjs",
    "indexnow:ping-all": "node scripts/indexnow-ping.mjs --all",
    "sitemap:ping": "node scripts/sitemap-ping.mjs",
    "seo:citations": "node scripts/seo-citation-monitor.mjs",
    "seo:rank": "node scripts/openpagerank-check.mjs",
    "seo:rank-csv": "node scripts/openpagerank-check.mjs --csv",
    "postbuild": "if [ \"$VERCEL_ENV\" = \"production\" ]; then node scripts/sitemap-ping.mjs --indexnow-only || true; else echo 'sitemap-ping: skipped (only runs on Vercel production builds)'; fi"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.0",
    "lucide-react": "^0.542.0",
    "next": "^16.2.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sonner": "^2.0.7",
    "stripe": "^20.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5",
    "vitest": "^3",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "ws": "^8.21.0",
    "qs": "^6.15.2",
    "postcss": "^8.5.10"
  }
}
